# Copy this template locally, fill all values, and upload it in Portainer's Stack environment variables panel.
# Never commit the completed environment file; it contains production secrets.
# Upload this completed file in Portainer: Stack -> Environment variables -> Load variables from .env file.
# Portainer exposes variables for Compose interpolation and generates stack.env for env_file services.
API_IMAGE=aireadyassessment-api:local
POSTGRES_DB=aireadyassessment
POSTGRES_USER=aireadyassessment
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
PROXY_NETWORK=alamia-network

# Runtime MCP is disabled until explicitly configured.
MCP_ENABLED=false
MCP_BEARER_TOKEN=

APP_NAME=AIReadyAssessment
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_STACK=stderr
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aireadyassessment
DB_USERNAME=aireadyassessment
DB_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
FILESYSTEM_DISK=local
FRONTEND_URL=https://www.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com
AI_CHAT_COMPLETIONS_URL=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER_LABEL=cloudflare-ai-gateway
AI_FALLBACK_CHAT_COMPLETIONS_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_PROVIDER=fallback-provider
AI_INPUT_PRICE_PER_MILLION_USD=
AI_OUTPUT_PRICE_PER_MILLION_USD=
AI_FALLBACK_INPUT_PRICE_PER_MILLION_USD=
AI_FALLBACK_OUTPUT_PRICE_PER_MILLION_USD=
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1800
AI_DAILY_SPEND_LIMIT_USD=5.00
AI_ENFORCE_SPEND_LIMIT=true
ASSESSMENT_MAX_UPLOAD_KB=10240
ASSESSMENT_MAX_TEXT_CHARS=30000
ASSESSMENT_MIN_JOB_DESCRIPTION_CHARS=80
ASSESSMENT_STATUS_TOKEN_TTL_DAYS=7
DOCUMENT_RETENTION_DAYS=30
INITIAL_ADMIN_NAME=AIReadyAssessment Admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS

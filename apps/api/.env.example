APP_NAME=AIReadyAssessment
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Local SQLite by default. Use PostgreSQL in production.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=aireadyassessment
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Configure a full OpenAI-compatible chat completions URL server-side.
# For Cloudflare AI Gateway + OpenRouter, use the documented gateway endpoint.
AI_CHAT_COMPLETIONS_URL=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER_LABEL=cloudflare-ai-gateway
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1800
AI_INPUT_PRICE_PER_MILLION_USD=
AI_OUTPUT_PRICE_PER_MILLION_USD=
AI_DAILY_SPEND_LIMIT_USD=5.00
AI_ENFORCE_SPEND_LIMIT=true

ASSESSMENT_MAX_UPLOAD_KB=10240
ASSESSMENT_MAX_TEXT_CHARS=30000
ASSESSMENT_MIN_JOB_DESCRIPTION_CHARS=80
ASSESSMENT_STATUS_TOKEN_TTL_DAYS=7
DOCUMENT_RETENTION_DAYS=30

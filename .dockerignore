# Git and editor state
.git
.github
.idea
.vscode

# Secrets (keep the safe example files only)
.env
.env.*
!.env.example

# Host-local runtime data
**/storage/logs/*
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/storage/app/private/*

# Dependencies are installed in the image
**/vendor
node_modules

# Composer-generated Laravel package manifests are regenerated inside the image.
**/bootstrap/cache/*

# Portainer-generated production environment file must never enter build context.
**/stack.env
